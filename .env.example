# Root environment for `docker compose up`.
# Copy to `.env` (compose auto-loads it) and fill in the Clerk values.
# Per-app dev configs still live in backend/.env and frontend/.env.

# --- Clerk authentication (F02) ------------------------------------------
# Issuer URL of your Clerk instance (the `iss` claim in session tokens).
# REQUIRED — the backend refuses to boot without it.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Comma-separated authorized parties (the `azp` claim) — your frontend origins.
# Defaults to the frontend's compose origin (http://localhost:8081) when unset.
CLERK_AUTHORIZED_PARTIES=http://localhost:8081
# Frontend publishable key — inlined into the Vite bundle at build time.
# REQUIRED — the frontend image fails to build without it. Public/client-safe.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# --- Backend wiring (optional; sane compose defaults applied) -------------
# Origin allowed by the backend's CORS layer. Defaults to http://localhost:8081.
FRONTEND_ORIGIN=http://localhost:8081
# Tracing filter (e.g. info, debug, agent_maker_flow_backend=debug).
RUST_LOG=info

# --- LiteLLM gateway (F03) -----------------------------------------------
# Master key for the proxy; must match general_settings.master_key in
# litellm/config.yaml. Shared by the litellm and backend services.
LITELLM_MASTER_KEY=sk-amf-dev

# Provider API keys are consumed by the LiteLLM container, NOT the backend.
# Leave blank to disable a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
