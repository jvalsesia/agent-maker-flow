# Database connection (PostgreSQL with pgvector)
DATABASE_URL=postgres://amf:amf@localhost:5432/amf

# Redis connection
REDIS_URL=redis://localhost:6379

# Address the HTTP server binds to
BIND_ADDR=0.0.0.0:8080

# Allowed CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Clerk authentication (F02)
# Issuer URL of your Clerk instance (the `iss` claim in session tokens).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: defaults to ${CLERK_ISSUER}/.well-known/jwks.json when unset.
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated authorized parties (the `azp` claim) — typically your frontend origins.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Frontend publishable key (consumed by the Vite app; safe to expose in the client).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# LiteLLM gateway (F03)
# Base URL of the LiteLLM proxy (the docker-compose `litellm` service in dev).
LITELLM_BASE_URL=http://localhost:4000
# Optional master key for the proxy; must match general_settings.master_key in litellm/config.yaml.
LITELLM_MASTER_KEY=sk-amf-dev
# Provider API keys below are consumed by the LiteLLM container, NOT the backend:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Tracing filter (e.g. info, debug, agent_maker_flow_backend=debug)
RUST_LOG=info
