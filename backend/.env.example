# Database connection (PostgreSQL with pgvector)
DATABASE_URL=postgres://amf:amf@localhost:5432/amf

# Redis connection
REDIS_URL=redis://localhost:6379

# Address the HTTP server binds to
BIND_ADDR=0.0.0.0:8080

# Allowed CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Tracing filter (e.g. info, debug, agent_maker_flow_backend=debug)
RUST_LOG=info
