# Clerk publishable key for the frontend (F02 Authentication).
# Find it in the Clerk dashboard under API Keys. Consumed by the Vite app;
# safe to expose in the client. Replace the placeholder with your own key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# Backend origin the Vite dev server proxies "/api" to. Node-side only (no
# VITE_ prefix) — the browser bundle always calls the relative "/api/v1" path,
# so this just sets the dev proxy target. In production nginx proxies "/api/"
# to the "backend" service instead (see frontend/nginx.conf).
BACKEND_URL=http://localhost:8080

