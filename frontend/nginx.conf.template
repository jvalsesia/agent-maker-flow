server {
    listen       80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # gzip the text assets nginx serves.
    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed, immutable build assets -> cache hard.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # Proxy API calls to the backend service.
    # ${BACKEND_URL} is substituted at container start by the nginx image's
    # envsubst step (see frontend/Dockerfile); defaults to the compose service
    # name "backend". Only env-defined vars are substituted, so nginx's own
    # $host / $remote_addr below are left intact.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Authorization    $http_authorization;

        # SSE: disable buffering + proxy timeout so streamed run events flow through.
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
    }

    # SPA history fallback — unknown paths resolve to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
